{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GurzuInc/agentic-engineering-workflow/schemas/policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "policy_version", "canonical_repository", "client_minimums", "canonical_policies", "lifecycle", "roles", "gates", "evidence_rules"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"type": "integer", "minimum": 1},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "canonical_repository": {"const": "GurzuInc/agentic-engineering-workflow"},
    "client_minimums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex"],
      "properties": {"codex": {"type": "string"}}
    },
    "canonical_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/idStatement"}},
    "lifecycle": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "outcome"], "properties": {"id": {"type": "string"}, "outcome": {"type": "string"}}, "additionalProperties": false}},
    "roles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "permission", "prompt"], "properties": {"id": {"type": "string"}, "permission": {"enum": ["writer", "read-only"]}, "prompt": {"type": "string"}}, "additionalProperties": false}},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "blocks", "evidence"], "properties": {"id": {"type": "string"}, "blocks": {"type": "string"}, "evidence": {"type": "string"}}, "additionalProperties": false}},
    "evidence_rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "requirement"], "properties": {"id": {"type": "string"}, "requirement": {"type": "string"}}, "additionalProperties": false}}
  },
  "$defs": {
    "idStatement": {"type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": {"id": {"type": "string", "pattern": "^workflow\\."}, "statement": {"type": "string", "minLength": 1}}}
  }
}
